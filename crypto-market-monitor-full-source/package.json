{
  "name": "crypto-market-monitor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:cryptobot": "node --import tsx --test tests/cryptobot/*.test.ts",
    "mcp:build-widget": "esbuild mcp/web/src/main.tsx --bundle --format=esm --minify --loader:.css=text --outfile=mcp/dist/widget.js",
    "mcp:build-server": "esbuild mcp/server.ts --bundle --platform=node --format=esm --outfile=mcp/dist/server.js",
    "mcp:build": "npm run mcp:build-widget && npm run mcp:build-server",
    "mcp:dev": "tsx mcp/server.ts",
    "mcp:start": "node mcp/dist/server.js",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@supabase/supabase-js": "2.55.0",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "jose": "6.2.10",
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "fast-uri": "3.1.6",
    "nanoid": "3.3.18"
  },
  "type": "module",
  "displayName": "Crypto Market Monitor"
}

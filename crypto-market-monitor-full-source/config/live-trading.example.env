# תבנית בלבד — אין להכניס כאן מפתחות או סודות אמיתיים.

TRADING_ENV=demo
LIVE_TRADING_ENABLED=false
WITHDRAWALS_ENABLED=false
BYBIT_BASE_URL=https://api-demo.bybit.com

# גבולות פתיחה מומלצים ל-Micro-Live לאחר אישור נפרד
MAX_ORDER_USDT=20
MAX_TOTAL_EXPOSURE_USDT=100
MAX_OPEN_POSITIONS=1
MAX_DAILY_LOSS_USDT=3
DEFAULT_LEVERAGE=1

# יש להגדיר כסודות בסביבת הריצה, לא בקובץ שבמאגר
BYBIT_API_KEY=
BYBIT_API_SECRET=
BOT_CRON_TOKEN=
OWNER_USER_ID=
